# ClarityLink tracks sanitized source and research notes, not vehicle data.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ROADMAP.md
!/PROJECT_STATE.md
!/NEXT_ACTION.md
!/EVIDENCE_INDEX.md
!/CONTRIBUTING.md
!/SECURITY.md
!/requirements-test.txt
!/.editorconfig
!/.github/
!/.github/**
!/docs/
!/docs/**
!/demo/
!/demo/**
!/tools/run_tests.sh
!/research/
!/step-reports/
!/third_party/
!/third_party/**
!/simulator/
!/tests/
!/src/
!/tools/
/tools/*
!/tools/README.md
!/tools/check_repo_health.py
!/tools/r6b_info_diff.py
!/tools/r6e_info_diff.py
!/tools/r6e_real_ios_lab.py
!/tools/r6h_livi_receiver.py
!/tools/r4b_preview.py
!/tools/elf_va_map.py
!/tools/jmcs_integration/
!/tools/jmcs_integration/*.py
!/tools/run_tests.sh
!/tools/analyze_43t0d_capture.py
!/tools/step43t0d_offline.py
!/tools/step43t0d3_netcfg_plan.py
!/tools/step43t0d3_static_review.py
!/tools/honda-readonly-preflight/
!/tools/honda-readonly-preflight/**
/tools/honda-readonly-preflight/__pycache__/
/tools/honda-readonly-preflight/*.pyc
/tools/**/__pycache__/
/tools/**/*.pyc
/src/**/__pycache__/
/src/**/*.pyc

# Raw and derived vehicle data stays outside Git.
/.local-backups/
/.local-artifacts/
/private-captures/
/research/captures/
!/research/captures/
/research/captures/*
!/research/captures/step5b/
/research/captures/step5b/*
!/research/captures/step5b/20260928T130534Z/
/research/captures/step5b/20260928T130534Z/*
!/research/captures/step5b/20260928T130534Z/CAPTURE_PLAN.md
!/research/captures/step5b/20260928T130534Z/CAPTURE_STATUS.md
/research/acquisition/live-inventory/
/research/acquisition/generated/
/research/local-model/runs/
/research/decompiled/
/research/decompiled-clean/
/research/deodexed/
/research/extracted/
/research/logs/
/research/resources/
/research/search/
/research/smali/
/research/tools/
/research/tmp/
/research/internet/livi/
/research/internet/livi-source/
/research/internet/livi-tree.json

# Native disassembly and copied binaries are derived from vendor firmware.
/research/native/*
!/research/native/*.md

# Private preferences, generated images, copied backups, and build output.
/research/simulator/working-backup/
/research/simulator/assets/
/research/simulator/*.png
/research/simulator/*captured*.jsonl
/research/simulator/guidance-card
/research/simulator/guidance-ocr
/demo/type111/runtime/
/research/extracted/
/research/probes/**/build/
/research/probes/**/apktool.yml
/research/probes/**/fixtures/*.mp4
/research/**/__pycache__/
/research/**/*.pyc
/tests/**/__pycache__/
/tests/**/*.pyc
/.venv/
/__pycache__/
/.pytest_cache/
/research/**/.DS_Store

# Never track credentials, signing material, or archives if new paths appear.
*.keystore
*.jks
*.p12
*.pem
*.key
*.apk
*.dex
*.odex
*.so
*.img
*.bin
*.tar
*.tar.gz
*.zip
*.pcap
*.pcapng
*.cap
*.dump
*.raw
