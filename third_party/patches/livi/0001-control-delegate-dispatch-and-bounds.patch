+import { describe, expect, it, vi } from 'vitest'
+import { encodeBplist } from '../bplist'
+import {
+  dispatchAndSerializeControlRequest,
+  dispatchControlRequest,
+  writeControlResponseOnce
+} from '../controlDelegate'
+import type { RtspRequest } from '../rtspMessage'
+import type { ControlSessionDelegate } from '../types'
+
+const request = (method: string, path: string, body = Buffer.alloc(0)): RtspRequest => ({
+  method,
+  path,
+  body,
+  protocol: 'RTSP/1.0',
+  headers: { cseq: '1' }
+})
+
+describe('exclusive ClarityLink control dispatch', () => {
+  it('routes claimed /info once and never calls LIVI stock handling', async () => {
+    const delegate: ControlSessionDelegate = {
+      handle: vi.fn(async () => ({ status: 200, body: Buffer.from('cl') })),
+      close: vi.fn(),
+      onAuthenticated: vi.fn()
+    }
+    const stock = vi.fn(async () => ({ status: 200, body: Buffer.from('stock') }))
+    const result = await dispatchControlRequest(request('GET', 'rtsp://host/info'), delegate, stock)
+    expect(result.body?.toString()).toBe('cl')
+    expect(delegate.handle).toHaveBeenCalledTimes(1)
+    expect(stock).not.toHaveBeenCalled()
+  })
+
+  it('routes stream SETUP exclusively and preserves nonclaimed stock handling', async () => {
+    const delegate: ControlSessionDelegate = {
+      handle: vi.fn(async () => ({ status: 200 })),
+      close: vi.fn(),
+      onAuthenticated: vi.fn()
+    }
+    const stock = vi.fn(async () => ({ status: 200 }))
+    await dispatchControlRequest(
+      request(
+        'SETUP',
+        'rtsp://host/session',
+        encodeBplist({
+          streams: [{ type: 110, streamConnectionID: 1001 }]
+        })
+      ),
+      delegate,
+      stock
+    )
+    expect(delegate.handle).toHaveBeenCalledTimes(1)
+    expect(stock).not.toHaveBeenCalled()
+    await dispatchControlRequest(request('POST', '/command'), delegate, stock)
+    expect(stock).toHaveBeenCalledTimes(1)
+  })
+
+  it('does not fall back after a delegate failure or refusal', async () => {
+    const stock = vi.fn(async () => ({ status: 200 }))
+    const delegate: ControlSessionDelegate = {
+      handle: vi.fn(async () => null),
+      close: vi.fn(),
+      onAuthenticated: vi.fn()
+    }
+    expect((await dispatchControlRequest(request('GET', '/info'), delegate, stock)).status).toBe(
+      503
+    )
+    expect(stock).not.toHaveBeenCalled()
+    const throwing: ControlSessionDelegate = {
+      handle: vi.fn(async () => {
+        throw new Error('private phone/session detail')
+      }),
+      close: vi.fn(),
+      onAuthenticated: vi.fn()
+    }
+    await expect(
+      dispatchControlRequest(request('SETUP', '/session'), throwing, stock)
+    ).rejects.toThrow('private phone/session detail')
+    expect(stock).not.toHaveBeenCalled()
+  })
+
+  it('response ownership oracle counts exactly one owner, serializer and writer', async () => {
+    const requestGet = request('GET', '/info')
+    const delegatedHandler = vi.fn(async () => ({ status: 200, body: Buffer.from('cl') }))
+    const stockHandler = vi.fn(async () => ({ status: 200, body: Buffer.from('stock') }))
+    const delegate: ControlSessionDelegate = {
+      handle: delegatedHandler,
+      close: vi.fn(),
+      onAuthenticated: vi.fn()
+    }
+    const serializer = vi.fn(() => Buffer.from('wire'))
+    const writer = vi.fn()
+
+    const live = await dispatchAndSerializeControlRequest(
+      requestGet,
+      delegate,
+      stockHandler,
+      serializer
+    )
+    writeControlResponseOnce(writer, live.wire)
+    expect([
+      delegatedHandler.mock.calls.length,
+      stockHandler.mock.calls.length,
+      serializer.mock.calls.length,
+      writer.mock.calls.length
+    ]).toEqual([1, 0, 1, 1])
+
+    delegatedHandler.mockClear()
+    stockHandler.mockClear()
+    serializer.mockClear()
+    writer.mockClear()
+    const stock = await dispatchAndSerializeControlRequest(
+      request('POST', '/command'),
+      delegate,
+      stockHandler,
+      serializer
+    )
+    writeControlResponseOnce(writer, stock.wire)
+    expect([
+      delegatedHandler.mock.calls.length,
+      stockHandler.mock.calls.length,
+      serializer.mock.calls.length,
+      writer.mock.calls.length
+    ]).toEqual([0, 1, 1, 1])
+
+    const broken: ControlSessionDelegate = {
+      handle: vi.fn(async () => {
+        throw new Error('private exception')
+      }),
+      close: vi.fn(),
+      onAuthenticated: vi.fn()
+    }
+    delegatedHandler.mockClear()
+    stockHandler.mockClear()
+    serializer.mockClear()
+    writer.mockClear()
+    const failure = await dispatchAndSerializeControlRequest(
+      request('SETUP', '/session'),
+      broken,
+      stockHandler,
+      serializer
+    )
+    writeControlResponseOnce(writer, failure.wire)
+    expect(failure).toMatchObject({ delegated: true, failed: true, status: 500 })
+    expect([
+      broken.handle.mock.calls.length,
+      stockHandler.mock.calls.length,
+      serializer.mock.calls.length,
+      writer.mock.calls.length
+    ]).toEqual([1, 0, 1, 1])
+  })
+})
