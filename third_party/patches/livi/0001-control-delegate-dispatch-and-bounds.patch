index 0000000..9a77b35
--- /dev/null
+++ b/src/main/services/projection/driver/cp/stack/controlDelegate.ts
@@ -0,0 +1,43 @@
+import { buildResponse, type RtspRequest, type RtspResponse } from './rtspMessage'
+import type { ControlSessionDelegate } from './types'
+
+export function isDelegatedControlRequest(request: RtspRequest): boolean {
+  if (request.method === 'GET' && request.path.toLowerCase().endsWith('/info')) return true
+  // ClarityLink owns the entire SETUP method, including malformed/session-level
+  // requests; otherwise LIVI could create competing stream state on failure.
+  return request.method === 'SETUP'
+}
+
+/** A claimed request cannot fall through to stock handling, including failure. */
+export async function dispatchControlRequest(
+  request: RtspRequest,
+  delegate: ControlSessionDelegate | undefined,
+  stockHandler: () => Promise<RtspResponse>
+): Promise<RtspResponse> {
+  if (!delegate || !isDelegatedControlRequest(request)) return stockHandler()
+  return (await delegate.handle(request)) ?? { status: 503 }
+}
+
+/** Production orchestration: one dispatch result, one serializer invocation. */
+export async function dispatchAndSerializeControlRequest(
+  request: RtspRequest,
+  delegate: ControlSessionDelegate | undefined,
+  stockHandler: () => Promise<RtspResponse>,
+  serializer = buildResponse
+): Promise<{ wire: Buffer; delegated: boolean; failed: boolean; status: number }> {
+  const delegated = Boolean(delegate && isDelegatedControlRequest(request))
+  let response: RtspResponse
+  let failed = false
+  try {
+    response = await dispatchControlRequest(request, delegate, stockHandler)
+  } catch {
+    response = { status: 500 }
+    failed = true
+  }
+  return { wire: serializer(request, response), delegated, failed, status: response.status ?? 200 }
+}
+
+/** A named single-write boundary used by CpStack and the ownership oracle. */
+export function writeControlResponseOnce(writer: (data: Buffer) => unknown, data: Buffer): void {
+  writer(data)
+}
