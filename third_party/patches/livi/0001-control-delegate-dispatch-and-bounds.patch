+import { randomUUID } from 'node:crypto'
+import net from 'node:net'
+import { expect, it } from 'vitest'
+import { decodeBplist, encodeBplist } from '../bplist'
+import { LiviUnixControlDelegate } from '../liviUnixControlDelegate'
+
+function readLine(socket: net.Socket): Promise<unknown[]> {
+  return new Promise((resolve, reject) => {
+    let pending = Buffer.alloc(0)
+    const onData = (chunk: Buffer): void => {
+      pending = Buffer.concat([pending, chunk])
+      const end = pending.indexOf(10)
+      if (end < 0) return
+      socket.off('data', onData)
+      try {
+        resolve(JSON.parse(pending.subarray(0, end).toString('ascii')) as unknown[])
+      } catch {
+        reject(new Error('bad test frame'))
+      }
+    }
+    socket.on('data', onData)
+    socket.once('error', reject)
+  })
+}
+
+it('exchanges authenticated generation and one request through local IPC', async () => {
+  const socketPath = `/tmp/clh-${randomUUID().slice(0, 8)}.sock`
+  const server = net.createServer()
+  await new Promise<void>((resolve) => server.listen(socketPath, resolve))
+  const accepted = new Promise<net.Socket>((resolve) => server.once('connection', resolve))
+  const delegate = new LiviUnixControlDelegate(socketPath)
+  try {
+    const auth = delegate.onAuthenticated(randomUUID())
+    const peer = await accepted
+    const hello = await readLine(peer)
+    expect(hello[0]).toBe(1)
+    expect(hello[1]).toBe('authenticated')
+    peer.write('[1,"session_ready",9]\n')
+    await auth
+
+    const request = {
+      method: 'GET',
+      path: 'rtsp://local/info',
+      protocol: 'RTSP/1.0',
+      headers: { 'content-type': 'application/x-apple-binary-plist' },
+      body: encodeBplist({})
+    }
+    const responsePromise = delegate.handle(request)
+    const frame = await readLine(peer)
+    expect(frame.slice(0, 7)).toEqual([
+      1,
+      'request',
+      9,
+      frame[3],
+      'GET',
+      'rtsp://local/info',
+      'application/x-apple-binary-plist'
+    ])
+    const body = encodeBplist({ ok: true }).toString('base64')
+    peer.write(
+      `${JSON.stringify([
+        1,
+        'response',
+        9,
+        frame[3],
+        200,
+        'application/x-apple-binary-plist',
+        body
+      ])}\n`
+    )
+    const response = await responsePromise
+    expect(response?.status).toBe(200)
+    expect(decodeBplist(response?.body as Buffer)).toEqual({ ok: true })
+    peer.destroy()
+  } finally {
+    delegate.close()
+    await new Promise<void>((resolve) => server.close(() => resolve()))
+  }
+})
