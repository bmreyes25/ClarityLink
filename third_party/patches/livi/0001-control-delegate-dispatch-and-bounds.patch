+import { randomUUID } from 'node:crypto'
+import net from 'node:net'
+import type { RtspRequest, RtspResponse } from './rtspMessage'
+import type { ControlSessionDelegate } from './types'
+
+const VERSION = 1
+const MAX_FRAME_BYTES = 1_400_000
+const PROOF = 'mfi_auth_setup_response_then_pair_verify_then_next_control_request'
+const PLIST_TYPE = 'application/x-apple-binary-plist'
+
+/** Local-only IPC client. It receives no MFi signer, challenge, or key state. */
+export class LiviUnixControlDelegate implements ControlSessionDelegate {
+  private socket: net.Socket | null = null
+  private pending = Buffer.alloc(0)
+  private sessionId: string | null = null
+  private generation: number | null = null
+  private activeRequestId: string | null = null
+  private closed = false
+  constructor(private readonly socketPath: string) {
+    if (!socketPath.startsWith('/') || Buffer.byteLength(socketPath) > 103) {
+      throw new Error('invalid ClarityLink local socket path')
+    }
+  }
+
+  async onAuthenticated(sessionId: string): Promise<void> {
+    if (this.closed) throw new Error('delegate closed')
+    if (this.sessionId === sessionId && this.generation !== null) return
+    if (this.sessionId !== null) throw new Error('delegate session already claimed')
+    this.sessionId = sessionId
+    const socket = net.createConnection({ path: this.socketPath })
+    this.socket = socket
+    socket.on('error', () => {
+      this.closed = true
+    })
+    socket.setTimeout(30_000, () => socket.destroy(new Error('local bridge timeout')))
+    await new Promise<void>((resolve, reject) => {
+      const failed = (error: Error): void => reject(error)
+      socket.once('error', failed)
+      socket.once('connect', () => {
+        socket.off('error', failed)
+        resolve()
+      })
+    })
+    await this.send([VERSION, 'authenticated', sessionId, PROOF])
+    const ready = await this.readFrame()
+    if (
+      ready.length !== 3 ||
+      ready[0] !== VERSION ||
+      ready[1] !== 'session_ready' ||
+      !Number.isSafeInteger(ready[2]) ||
+      Number(ready[2]) < 1
+    ) {
+      throw new Error('invalid ClarityLink session acknowledgement')
+    }
+    this.generation = Number(ready[2])
+  }
+
+  async handle(request: RtspRequest): Promise<RtspResponse | null> {
+    if (!this.socket || this.generation === null || this.closed || this.activeRequestId) {
+      throw new Error('ClarityLink bridge unavailable')
+    }
+    const requestId = randomUUID()
+    this.activeRequestId = requestId
+    try {
+      await this.send([
+        VERSION,
+        'request',
+        this.generation,
+        requestId,
+        request.method,
+        request.path,
+        request.headers['content-type'] ?? null,
+        request.body.toString('base64')
+      ])
+      const frame = await this.readFrame()
+      if (
+        frame.length !== 7 ||
+        frame[0] !== VERSION ||
+        frame[1] !== 'response' ||
+        frame[2] !== this.generation ||
+        frame[3] !== requestId ||
+        !Number.isSafeInteger(frame[4]) ||
+        Number(frame[4]) < 100 ||
+        Number(frame[4]) > 599 ||
+        frame[5] !== PLIST_TYPE ||
+        typeof frame[6] !== 'string'
+      ) {
+        throw new Error('invalid ClarityLink response frame')
+      }
+      const body = Buffer.from(frame[6], 'base64')
+      if (body.length > 1_000_000 || body.toString('base64') !== frame[6]) {
+        throw new Error('invalid ClarityLink response body')
+      }
+      return { status: Number(frame[4]), headers: { 'Content-Type': PLIST_TYPE }, body }
+    } finally {
+      this.activeRequestId = null
+    }
+  }
+
+  private send(value: unknown[]): Promise<void> {
+    if (!this.socket || this.closed) return Promise.reject(new Error('bridge closed'))
+    const frame = Buffer.from(`${JSON.stringify(value)}\n`, 'ascii')
+    if (frame.length > MAX_FRAME_BYTES) return Promise.reject(new Error('bridge frame limit'))
+    return new Promise((resolve, reject) =>
+      this.socket!.write(frame, (error) =>
+        error ? reject(new Error('bridge write failed')) : resolve()
+      )
+    )
+  }
+
+  private readFrame(): Promise<unknown[]> {
+    if (!this.socket || this.closed) return Promise.reject(new Error('bridge closed'))
+    return new Promise((resolve, reject) => {
+      const socket = this.socket!
+      const onData = (chunk: Buffer): void => {
+        this.pending = Buffer.concat([this.pending, chunk])
+        if (this.pending.length > MAX_FRAME_BYTES) {
+          cleanup()
+          reject(new Error('bridge frame limit'))
+          socket.destroy()
+          return
+        }
+        const end = this.pending.indexOf(10)
+        if (end < 0) return
+        const line = this.pending.subarray(0, end)
+        this.pending = Buffer.from(this.pending.subarray(end + 1))
+        cleanup()
+        try {
+          const parsed: unknown = JSON.parse(line.toString('ascii'))
+          if (!Array.isArray(parsed)) throw new Error('invalid frame shape')
+          resolve(parsed)
+        } catch {
+          reject(new Error('malformed bridge frame'))
+          socket.destroy()
+        }
+      }
+      const onError = (): void => {
+        cleanup()
+        reject(new Error('bridge disconnected'))
+      }
+      const onEnd = (): void => {
+        cleanup()
+        reject(new Error('bridge disconnected'))
+      }
+      const cleanup = (): void => {
+        socket.off('data', onData)
+        socket.off('error', onError)
+        socket.off('end', onEnd)
+      }
+      socket.on('data', onData)
+      socket.once('error', onError)
+      socket.once('end', onEnd)
+    })
+  }
+
+  close(): void {
+    this.closed = true
+    this.activeRequestId = null
+    this.pending = Buffer.alloc(0)
+    this.socket?.destroy()
+    this.socket = null
+    this.generation = null
+    this.sessionId = null
+  }
+}
